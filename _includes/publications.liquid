{% comment %}
  Publications list styled in the al-folio bibliography layout.
  Matches the format on https://zhexianli-usc.github.io/.
{% endcomment %}
<div class="publications">
  <ol class="bibliography">
    {% for pub in site.data.publications %}
      <li>
        <div class="row">
          <div class="col col-sm-2 abbr">
            {% if pub.abbr and pub.abbr != '' %}
              <abbr class="badge rounded w-100">{{ pub.abbr }}</abbr>
            {% endif %}
            {% if pub.preview and pub.preview != '' %}
              <figure>
                <picture>
                  <img class="preview z-depth-1 rounded" src="{{ pub.preview | relative_url }}" alt="{{ pub.title }}" width="100%" height="auto">
                </picture>
              </figure>
            {% endif %}
          </div>
          <div class="col-sm-8" id="{{ pub.id }}">
            <div class="title">{{ pub.title }}</div>
            <div class="author">{{ pub.authors }}</div>
            <div class="periodical">
              <em>{{ pub.venue }}</em>{% if pub.year and pub.year != '' %}, {{ pub.year }}{% endif %}
            </div>
            <div class="links">
              {% if pub.abstract %}
                <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
              {% endif %}
              {% if pub.arxiv %}
                <a class="btn btn-sm z-depth-0" href="{{ pub.arxiv }}" role="button" target="_blank" rel="noopener noreferrer">arXiv</a>
              {% endif %}
              {% if pub.pdf %}
                <a class="btn btn-sm z-depth-0" href="{{ pub.pdf | relative_url }}" role="button" target="_blank" rel="noopener noreferrer">PDF</a>
              {% endif %}
              {% if pub.code %}
                <a class="btn btn-sm z-depth-0" href="{{ pub.code }}" role="button" target="_blank" rel="noopener noreferrer">Code</a>
              {% endif %}
              {% if pub.presentation %}
                <a class="btn btn-sm z-depth-0" href="{{ pub.presentation | relative_url }}" role="button" target="_blank" rel="noopener noreferrer">Presentation</a>
              {% endif %}
              {% if pub.project_page %}
                <a class="btn btn-sm z-depth-0" href="{{ pub.project_page }}" role="button" target="_blank" rel="noopener noreferrer">Project Page</a>
              {% endif %}
            </div>
            {% if pub.abstract %}
              <div class="abstract hidden">
                <p>{{ pub.abstract }}</p>
              </div>
            {% endif %}
          </div>
        </div>
      </li>
    {% endfor %}
  </ol>
</div>
