{% comment %}
  Media slot for a research/project card.

  Resolves, in order: a video (when the file is present on disk), an image
  (when present), and otherwise a neutral "media pending" placeholder — so a
  card never renders a broken image or a stock photo.

  Params: item (hash with video/image/poster/alt), kind ("research"|"project")
{% endcomment %}

{% assign item = include.item %}

{% assign has_video = false %}
{% if item.video and item.video != '' %}
  {% capture video_exists %}{% file_exists {{ item.video | remove_first: '/' }} %}{% endcapture %}
  {% if video_exists == 'true' %}
    {% assign has_video = true %}
  {% endif %}
{% endif %}

{% assign has_image = false %}
{% if item.image and item.image != '' %}
  {% capture image_exists %}{% file_exists {{ item.image | remove_first: '/' }} %}{% endcapture %}
  {% if image_exists == 'true' %}
    {% assign has_image = true %}
  {% endif %}
{% endif %}

<div class="card-media">
  {% if has_video %}
    <video
      class="card-media-el"
      src="{{ item.video | relative_url }}"
      {% if has_image %}poster="{{ item.image | relative_url }}"{% endif %}
      preload="metadata"
      muted
      loop
      playsinline
      controls
      aria-label="{{ item.alt | default: item.title | escape }}"
    ></video>
  {% elsif has_image %}
    <img
      class="card-media-el"
      src="{{ item.image | relative_url }}"
      alt="{{ item.alt | default: item.title | escape }}"
      loading="lazy"
      decoding="async"
    />
  {% else %}
    <div class="card-media-placeholder" role="img" aria-label="Media not yet available for {{ item.title | escape }}">
      <svg viewBox="0 0 64 44" aria-hidden="true" focusable="false">
        <rect x="1.5" y="1.5" width="61" height="41" rx="3" />
        <circle cx="20" cy="16" r="5" />
        <path d="M6 37 L24 21 L36 31 L46 23 L58 37 Z" />
      </svg>
      <span class="placeholder-note">Media pending</span>
    </div>
  {% endif %}
</div>
